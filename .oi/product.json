{
  "schema": "oi.product-lifecycle/v1",
  "id": "ai-kit",
  "public_name": "AIKit",
  "version": "0.1.0",
  "repository": "https://github.com/EpiLogos/ai-kit",
  "source_checkout": "ai-kit",
  "lockfile": "Cargo.lock",
  "artifact": {
    "kind": "cli",
    "entry": "aikit",
    "platforms": ["aarch64-apple-darwin", "x86_64-unknown-linux-gnu"]
  },
  "build": {
    "command": ["cargo", "build", "--workspace", "--locked", "--release"]
  },
  "verify": {
    "source_command": ["cargo", "test", "--workspace", "--all-targets", "--locked"],
    "installed_command": ["aikit", "doctor", "--json"]
  },
  "capability_matrices": {
    "schema": "oi.product-capability-sources/v1",
    "primary_id": "aikit-product-profile",
    "matrices": [
      {
        "id": "aikit-product-profile",
        "role": "suite-profile",
        "protocol": "ql-capability-matrix/1",
        "suite_catalogue": true,
        "carriers": {
          "manifest": "ProjectCentral/user/telos/capability-matrix.json",
          "records": "ProjectCentral/user/telos/capability-matrix.csv",
          "rendering": "ProjectCentral/user/telos/capability-matrix.md",
          "account": "ProjectCentral/user/telos/aikit.html"
        }
      }
    ]
  },
  "install": {"mode": "oi-managed-binary"},
  "update": {"mode": "suite-manifest"},
  "remove": {"mode": "oi-managed-only"},
  "release": {
    "host": "github-releases",
    "tag_prefix": "aikit-v",
    "checksum": "sha256",
    "provenance": "github-artifact-attestation"
  }
}
